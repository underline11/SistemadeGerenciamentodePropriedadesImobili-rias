CREATE DATABASE IF NOT EXISTS SistemaImobiliario;
USE SistemaImobiliario;

CREATE TABLE clientes (
    id_cliente INT AUTO_INCREMENT PRIMARY KEY,
    nome VARCHAR(100) NOT NULL,
    telefone VARCHAR(20),
    email VARCHAR(100),
    orcamento_max DECIMAL(12, 2) -- Alterado para numérico para podermos filtrar
);

CREATE TABLE propriedades (
    id_propriedade INT AUTO_INCREMENT PRIMARY KEY,
    endereco VARCHAR(255) NOT NULL,
    tipo VARCHAR(50), -- Ex: Casa, Apartamento, Lote
    valor DECIMAL(12, 2),
    status VARCHAR(20) DEFAULT 'disponivel' -- disponivel, vendido, alugado
);

CREATE TABLE agentes (
    id_agente INT AUTO_INCREMENT PRIMARY KEY,
    nome VARCHAR(100) NOT NULL,
    comissao_percentual DECIMAL(5, 2)
);

CREATE TABLE transacoes (
    id_transacao INT AUTO_INCREMENT PRIMARY KEY,
    id_cliente INT,
    id_propriedade INT,
    id_agente INT,
    data_transacao DATE,
    FOREIGN KEY (id_cliente) REFERENCES clientes(id_cliente),
    FOREIGN KEY (id_propriedade) REFERENCES propriedades(id_propriedade),
    FOREIGN KEY (id_agente) REFERENCES agentes(id_agente)
);

-- Consultas corrigidas
SELECT * FROM propriedades WHERE status = 'disponivel';
SELECT * FROM clientes WHERE orcamento_max > 300000.00;
